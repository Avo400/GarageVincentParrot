{% extends 'base_user.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <section class="container">
        <div class="row">
            <div class="col">
                {% if isAdminAccount %}
                    <h1>Créer un compte administrateur</h1>
                {% elseif isEmployeeAccount %}
                    <h1>Créer un compte employé </h1>
                {% else %}
                    <h1>Créer un compte utilisateur </h1>
                {% endif %}    

                    {{ form_start(registrationForm) }}
                    <fieldset class="mb-3">
                        <legend> Mon identité</legend>
                        {{ form_row(registrationForm.lastname) }}
                        {{ form_row(registrationForm.firstname) }}
                        {{ form_row(registrationForm.email) }}
                    </fieldset>

                    <fieldset class="mb-3">
                        <legend> Mes coordonnées</legend>
                        {{ form_row(registrationForm.address) }}
                        {{ form_row(registrationForm.zipcode) }}
                        {{ form_row(registrationForm.city) }}
                    </fieldset>
                        {{ form_row(registrationForm.plainPassword, {
                            label: 'Mot de passe'
                        }) }}
                        {{ form_row(registrationForm.RGPDConsent) }}

                         {% if isAdminAccount %}
                             <button type="submit" class="btn btn-primary btn-lg my-3">Créer un compte admin</button>
                         {% elseif isEmployeeAccount %}
                             <button type="submit" class="btn btn-primary btn-lg my-3">Créer un compte d'employé </button>
                         {% elseif isEmployeeAccount %}
                             <button type="submit" class="btn btn-primary btn-lg my-3">Créer un compte utilisateur </button>
                         {% endif %}    
                         <button type="submit" class="btn btn-primary">
                             Créer le compte
                        </button>
                    {{ form_end(registrationForm) }}
            </div>
        </div>
    </section>
    
{% endblock %}

{% extends 'admin/base_admin.html.twig' %}

{% block body %}

            <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2>Liste des comptes</h2>

                    <a href="{{ path('admin_create_user') }}"
                    class="btn btn-primary">
                        Créer un compte
                    </a>
            </div>


            <form method="GET">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <input
                        type="text"
                        id="searchEmail"
                        name="searchEmail"
                        class="form-control"
                        placeholder="Rechercher par email"
                    />
                    <button class="btn btn-primary" type="submit"> Rechercher </button>
                </div>
            </form>
             


    <table class="table table-hover">
            <tr class="table-dark">
                <td> Email </td>
                <td>Rôle</td>
                <td> Informations </td>
                <td> Actions </td>
            </tr>
        {% for user in users %} 
                <tr class="table-secondary">
                    <td> {{ user.email }}</td>
                     
                        <td>
                            {% for role in user.roles %}
                                {% if role == 'ROLE_ADMIN' %}
                                    Administrateur
                                {% elseif role == 'ROLE_USER' %}
                                    Utilisateur
                                {% elseif role == 'ROLE_EMPLOYE' %}
                                Employé
                                {% endif %}
                            {% endfor %}
                        </td>

                     <td>
                        <a class="btn btn-primary" 
                            href="{{ path('admin_show_user',
                                    {
                                        'id': user.id,
                                        'searchEmail': searchEmail
                                    }
                                    ) }}">
                                Détails
                        </a>
                      </td>

                     
                    <td>
                         <a class="btn btn-primary" 
                            href="{{ path('admin_edit_user', {id: user.id}) }}">
                                Modifier
                        </a>
                        <a class="btn btn-primary" 
                            href="{{ path('admin_delete_user', {id: user.id}) }}">
                                Supprimer
                        </a>

                     </td>
                 
                    
               </tr>    
        {% endfor %}

</table>
    


{% endblock %}


{% extends 'base.html.twig' %}

{% block title %}Admin{% endblock %}

        {% block navbar %}
                    <nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
                    <div class="container-fluid">
                        <a class="navbar-brand" href="#">Garage Vincent Parrot</a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="navbarColor01">
                        <ul class="navbar-nav me-auto">
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('main') }}">
                                        Accueil
                                    </a>
                                </li>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li class="nav-item">
                                        <a class="nav-link" href="{{ path('admin_dashboard') }}">
                                            Espace admin
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" href="{{ path('admin_comptes') }}">
                                            Comptes
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" href="{{ path('admin_donnees') }}">
                                            Données
                                        </a>
                                    </li>
                                {% elseif is_granted('ROLE_EMPLOYE') %}
                                    <a class="nav-link" href="{{ path('employe_dashboard') }}">
                                            Espace employé
                                        </a>
                                {% endif %}       
                        </ul>

            <div class="d-flex align-items-center">
                {% if app.user %}
                    <span class="text-white me-3">
                        Connecté :
                        {{ app.user.email }}

                        {% if is_granted('ROLE_ADMIN') %}
                            | Statut : Admin
                        {% elseif is_granted('ROLE_EMPLOYE') %}
                            | Statut : Employé
                        {% else %}
                            | Statut : Utilisateur
                        {% endif %}
                    </span>
                {% endif %}

                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-light">
                        Se déconnecter
                    </a>
                {% endif %}
            </div>







                        </div>
                    </div>
                </nav>
         {% endblock %}
    
    {% block body %}{% endblock %}

    {% block admin_body %}{% endblock %}
   

     